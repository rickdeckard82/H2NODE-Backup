# ─────────────────────────────────────────────────────────────
# Pulse Backup — variáveis de ambiente
# Copie para .env (ou rode `make init`) e ajuste. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# ---- Domínio público e certificado (proxy Caddy + Let's Encrypt) ----
# Nome DNS (registro A/AAAA) apontando para o IP público deste servidor.
PUBLIC_DOMAIN=backup.example.com
# E-mail de contato da conta Let's Encrypt (avisos de expiração).
ACME_EMAIL=admin@example.com

# ---- PostgreSQL ----
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pulse_backup

# ---- Pasta dos backups no HOST (montada nos containers em /data) ----
# Use um disco/partição dedicado. O sshd ajusta o dono para o uid 10001.
BACKUP_STORAGE_PATH=/srv/pulse-backup/data

# ---- SSH/rsync (por onde os clientes enviam) ----
# Nome/IP que os CLIENTES usam para chegar aqui (vai no agent.conf).
# Vazio = PUBLIC_DOMAIN.
SSH_PUBLIC_HOST=
SSH_PUBLIC_PORT=2222
# Interface em que o sshd escuta no host (rede do host — obedece ao ufw).
SSH_BIND=0.0.0.0

# ---- Receptores FTP/TFTP (switches e roteadores) ----
# IP que os EQUIPAMENTOS usam para chegar aqui (vai nos comandos de exemplo do
# painel). Huawei/Datacom pedem IP, não nome. Vazio = SSH_PUBLIC_HOST.
NET_PUBLIC_HOST=
FTP_PORT=21
# Faixa do FTP passivo — libere no ufw só para os IPs dos equipamentos.
FTP_PASSIVE_PORTS=30000-30049
# IP anunciado no modo passivo se o servidor estiver atrás de NAT (vazio = não).
FTP_MASQUERADE_ADDRESS=
TFTP_PORT=69
NET_MAX_FILE_MB=64
# Tipo "Arquivos e bancos" (dumps .sql, .zip… enviados por FTP): tamanho máximo por arquivo.
NET_FILES_MAX_MB=4096
# Página FTP Firmwares: tamanho máximo de um firmware enviado pelo painel.
FIRMWARE_MAX_MB=2048

# ---- Coletor (puller): MikroTik por SSH ----
# Coletas simultâneas e segundos sem resposta antes de desistir de um equipamento.
PULL_CONCURRENCY=4
PULL_TIMEOUT_SECONDS=60

# ---- Backend (FastAPI) ----
# Chave de assinatura dos JWT — MÍNIMO 32 caracteres (openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret-32-bytes-hex
# Chave Fernet para cifrar em repouso o segredo do 2FA e as senhas das credenciais MikroTik
# Gere com: openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=change-me-fernet-key-base64
ACCESS_TOKEN_TTL_MINUTES=15
# Papéis que só usam o painel com 2FA ativo (vírgula; vazio = 2FA opcional)
MFA_REQUIRED_ROLES=admin,operator
REFRESH_TOKEN_TTL_DAYS=7
# URL pública do painel, usada no CORS. Vazio = https://PUBLIC_DOMAIN.
FRONTEND_ORIGIN=
# Mantenha true: o proxy externo entrega HTTPS ao navegador.
COOKIE_SECURE=true
# IP(s) de proxy confiáveis para ler X-Forwarded-* (o backend só é alcançado
# pelo container frontend, então "*" é seguro neste desenho).
FORWARDED_ALLOW_IPS=*
ENABLE_DOCS=false
LOG_LEVEL=INFO

# ---- Primeiro usuário do painel (criado pelo seed) ----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-strong

# ---- Worker ----
WORKER_POLL_SECONDS=30
# Upload sem manifest.json há mais que isso vai para a quarentena.
INCOMING_STALE_HOURS=12
# Reverifica (decifra e testa de novo) cada backup guardado a cada N dias. 0 = nunca.
REVERIFY_INTERVAL_DAYS=30
# Tolerância além do intervalo esperado do cliente antes de acusar "atrasado".
OVERDUE_GRACE_MINUTES=120

# ---- Porta interna do painel ----
# O container frontend escuta só em 127.0.0.1:${WEB_PORT}; o acesso público é
# pelo proxy HTTPS (443). Mude só se a 8080 já estiver em uso no host.
WEB_PORT=8080
