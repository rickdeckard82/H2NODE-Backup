# /etc/h2node-backup/agent.conf — exemplo. O painel gera este arquivo já preenchido
# em Clientes → (cliente) → Configuração do agente.
# Permissões obrigatórias: dono root, modo 600 (o agente se recusa a rodar se não for).

CLIENT_ID="COLOQUE-O-ID-DO-CLIENTE"
SERVER_HOST="backup.suaempresa.com.br"
SERVER_PORT="2222"
SERVER_USER="backup"
SSH_KEY="/etc/h2node-backup/id_ed25519"
KNOWN_HOSTS="/etc/h2node-backup/known_hosts"

# Chave pública GPG do servidor (baixe em Configuração → Chaves e servidor).
GPG_PUBLIC_KEY="/etc/h2node-backup/backup-key.pub.asc"
# O agente confere a chave antes de cifrar — evita cifrar para a chave errada.
GPG_FINGERPRINT="PREENCHA-COM-A-IMPRESSAO-DIGITAL"

# Pasta temporária local (só arquivos JÁ cifrados ficam aqui; apagados ao final).
WORK_DIR="/var/tmp/h2node-backup"

# ---- Pastas ----
BACKUP_PATHS=(
  "/etc"
  # "/var/www"
  # "/home"
)
EXCLUDES=(
  # "/var/www/*/cache"
  # "*.tmp"
)
ONE_FILE_SYSTEM="no"

# ---- Arquivos como estão (ex.: backups de conta do cPanel) ----
# Cada arquivo é cifrado como está e enviado um a um (cifra, envia, apaga): a pasta
# WORK_DIR só precisa caber o MAIOR arquivo. "@latest" = a pasta datada mais recente.
BACKUP_FILES=(
  # só a pasta de HOJE (2026-10-16): se o backup de hoje não existir, o agente acusa falha
  # "/backup/cpanel/@today/accounts/*.tar.gz"
)
# "@yesterday" = a pasta de ONTEM: para rodar o agente no dia seguinte ao backup do WHM (backup
# demorado), com o cron nos dias seguintes (WHM seg/qua/sex -> agente ter/qui/sáb: "0 22 * * 2,4,6").
# "@latest" no lugar de "@today" pega a pasta datada mais recente (reenvia a de ontem se a de hoje falhar).
# Arquivo alterado há menos de FILES_MIN_AGE_MINUTES (padrão 10) ainda está em gravação: não é enviado.
# Servidor cPanel: o agente confere se TODAS as contas (/var/cpanel/users) têm backup na pasta
# ".../accounts/" do dia; cada conta que faltar vira falha no painel (backup do WHM ainda rodando
# ou conta pulada). Respeita contas com backup desligado e "Backup Suspended Accounts".
# CPANEL_CHECK_ACCOUNTS="auto"   # auto (padrão) | no
# Pastas pequenas (ex.: a pasta "system" do cPanel) vão inteiras, em BACKUP_PATHS, também com "@today":
#   BACKUP_PATHS=( "/etc" "/backup/cpanel/@today/system" )

# ---- MySQL / MariaDB ----  (autenticação: unix_socket do root ou MYSQL_DEFAULTS_FILE)
MYSQL_ENABLED="no"
MYSQL_DATABASES=( "all" )
MYSQL_DEFAULTS_FILE=""          # ex.: /etc/h2node-backup/mysql.cnf ([client] user/password), modo 600
MYSQL_DUMP_OPTS=""

# ---- PostgreSQL ----  (roda pg_dump como o usuário do SO abaixo, via peer)
POSTGRES_ENABLED="no"
POSTGRES_DATABASES=( "all" )
POSTGRES_OS_USER="postgres"
POSTGRES_GLOBALS="yes"          # inclui roles/tablespaces (pg_dumpall --globals-only)

# ---- SQL Server (mssql-server para Linux) ----
MSSQL_ENABLED="no"
MSSQL_DATABASES=( "all" )
MSSQL_SERVER="localhost"
MSSQL_USER="sa"
MSSQL_PASSWORD_FILE="/etc/h2node-backup/mssql.pass"   # modo 600
MSSQL_BACKUP_DIR="/var/opt/mssql/data/h2node-backup" # gravável pelo usuário mssql

# ---- Envio ----
BWLIMIT=""                      # KB/s (vazio = sem limite)
UPLOAD_RETRIES="3"
LOG_FILE="/var/log/h2node-backup.log"
